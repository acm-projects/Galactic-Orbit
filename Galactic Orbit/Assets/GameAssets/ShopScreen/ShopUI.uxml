            <ui:Button text="&#10;" name="closeButton" class="button-transition" style="flex-direction: row; align-items: center; background-color: rgb(114, 109, 168); border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; border-top-width: 0.2px; border-right-width: 0.2px; border-bottom-width: 0.2px; border-left-width: 0.2px; justify-content: flex-start; -unity-text-align: middle-center; left: auto; border-left-color: rgb(248, 244, 225); border-right-color: rgb(248, 244, 225); border-top-color: rgb(248, 244, 225); border-bottom-color: rgb(248, 244, 225); width: 25px; position: absolute; top: auto; height: 25px; font-size: 10px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; align-self: center; bottom: 3%; background-image: url(&quot;project://database/Assets/GameAssets/Galactic%20Orbit%20Assets/ExitButtonImage.png?fileID=2800000&amp;guid=f2c79e4ceb650a04c9a234aba358efac&amp;type=3#ExitButtonImage&quot;);" />
        </ui:VisualElement>
    </GradientQuad>
</ui:UXML>
