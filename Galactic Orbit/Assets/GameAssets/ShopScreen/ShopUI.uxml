<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/GameAssets/StyleSheets/ShopStyles.uss?fileID=7433441132597879392&amp;guid=fc2a5887fa9721c49bf38b99b8471638&amp;type=3#ShopStyles" />
    <GradientQuad top-color="#110069FF" bottom-color="#6024A8FF" style="width: 100%; height: 100%;">
        <ui:VisualElement name="Background" style="flex-grow: 1; background-color: rgba(127, 190, 235, 0); -unity-background-image-tint-color: rgb(179, 215, 255);">
            <ui:VisualElement name="TitleContainer" style="flex-grow: 0;">
                <ui:Label text="Shop" name="shopLabel" style="color: rgb(255, 255, 255); font-size: 20px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Eagle_Lake/Poppins/Poppins-Bold.ttf?fileID=12800000&amp;guid=b3a755851803b4f499586e81bf43acb6&amp;type=3#Poppins-Bold&quot;); -unity-text-align: upper-left; align-self: center; border-bottom-width: 1px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); padding-left: 8px; padding-right: 8px; margin-top: 20px;" />
            </ui:VisualElement>
            <ui:VisualElement name="MoneyContainer" style="flex-grow: 0; margin-top: 10px; flex-direction: row; align-items: center; justify-content: center;">
                <ui:VisualElement name="coinImage" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/GameAssets/Galactic%20Orbit%20Assets/coins.png?fileID=2800000&amp;guid=888662c992c893b449fcf56331cacafb&amp;type=3#coins&quot;); width: 45px; height: 45px; -unity-background-scale-mode: scale-and-crop; position: relative;" />
                <ui:Label text="100" name="coinCount" style="font-size: 18px; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Eagle_Lake/Poppins/Poppins-SemiBold.ttf?fileID=12800000&amp;guid=bd892b78fff3640519c300051fbffbd1&amp;type=3#Poppins-SemiBold&quot;);" />
            </ui:VisualElement>
            <ui:VisualElement name="Separator" style="flex-grow: 0; width: 100%; height: 20px; justify-content: center; align-items: center; flex-direction: row;">
                <ui:VisualElement name="lineSplitter1" style="flex-grow: 1; background-color: rgb(123, 121, 121); height: 1px;" />
                <ui:Label text="Accessories" name="accessoryLabel" style="color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Eagle_Lake/Eagle_Lake/EagleLake-Regular.ttf?fileID=12800000&amp;guid=dea84b0b3089e4d009e49cc6f5d3c17d&amp;type=3#EagleLake-Regular&quot;); font-size: 13px; -unity-text-align: middle-center; margin-right: 2px;" />
                <ui:VisualElement name="lineSplitter1" style="flex-grow: 1; background-color: rgb(123, 121, 121); height: 1px;" />
            </ui:VisualElement>
            <ui:VisualElement name="ItemGrid" style="flex-grow: 1; margin-bottom: 50px; flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: center; padding-top: 20px;">
                <ui:VisualElement name="EyesItemContainer" style="align-items: center; height: 120px; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; border-left-color: rgba(255, 255, 255, 0.2); border-right-color: rgba(255, 255, 255, 0.2); border-top-color: rgba(255, 255, 255, 0.2); border-bottom-color: rgba(255, 255, 255, 0.2); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; background-color: rgba(255, 255, 255, 0.01);">
                    <ui:VisualElement name="tieImage" style="flex-grow: 0; background-image: resource(&apos;Faces/Eyes5&apos;); width: 80px; height: 80px; background-size: 180% 180%;" />
                    <ui:Button text="&#10;" name="EyesButton" class="button-transition" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-left-color: rgba(255, 255, 255, 0.39); border-right-color: rgba(255, 255, 255, 0.39); border-top-color: rgba(255, 255, 255, 0.39); border-bottom-color: rgba(255, 255, 255, 0.39); background-color: rgba(255, 255, 255, 0.02); width: 65px; height: 25px; flex-direction: row; align-items: center; justify-content: center; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                        <ui:VisualElement name="coinImage" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/GameAssets/Galactic%20Orbit%20Assets/CoinImage.png?fileID=2800000&amp;guid=95d2f085caeba477598c6c7014f83f27&amp;type=3#CoinImage&quot;); width: 22px; height: 22px; -unity-background-scale-mode: scale-and-crop; position: relative;" />
                        <ui:Label text="35" name="price1" style="font-size: 13px; color: rgb(127, 190, 235); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Eagle_Lake/Poppins/Poppins-Medium.ttf?fileID=12800000&amp;guid=f00b46b77f4f241b286026f513a3f4e3&amp;type=3#Poppins-Medium&quot;); -unity-text-align: middle-center;" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="Gap" style="flex-grow: 0; width: 20px;" />
                <ui:VisualElement name="MouthItemContainer" style="align-items: center; height: 120px; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; border-left-color: rgba(255, 255, 255, 0.2); border-right-color: rgba(255, 255, 255, 0.2); border-top-color: rgba(255, 255, 255, 0.2); border-bottom-color: rgba(255, 255, 255, 0.2); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; background-color: rgba(255, 255, 255, 0.01);">
                    <ui:VisualElement name="scarfImage" style="flex-grow: 0; background-image: resource(&apos;Faces/Mouth5&apos;); width: 80px; height: 80px; background-size: 180% 180%;" />
                    <ui:Button text="&#10;" name="MouthButton" class="button-transition" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-left-color: rgba(255, 255, 255, 0.39); border-right-color: rgba(255, 255, 255, 0.39); border-top-color: rgba(255, 255, 255, 0.39); border-bottom-color: rgba(255, 255, 255, 0.39); background-color: rgba(255, 255, 255, 0.02); width: 65px; height: 25px; flex-direction: row; align-items: center; justify-content: center; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                        <ui:VisualElement name="coinImage" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/GameAssets/Galactic%20Orbit%20Assets/CoinImage.png?fileID=2800000&amp;guid=95d2f085caeba477598c6c7014f83f27&amp;type=3#CoinImage&quot;); width: 22px; height: 22px; -unity-background-scale-mode: scale-and-crop; position: relative;" />
                        <ui:Label text="30&#10;" name="price1" style="font-size: 13px; color: rgb(127, 190, 235); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Eagle_Lake/Poppins/Poppins-Medium.ttf?fileID=12800000&amp;guid=f00b46b77f4f241b286026f513a3f4e3&amp;type=3#Poppins-Medium&quot;); -unity-text-align: middle-center;" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="DecorItemContainer" style="align-items: center; height: 120px; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; border-left-color: rgba(255, 255, 255, 0.2); border-right-color: rgba(255, 255, 255, 0.2); border-top-color: rgba(255, 255, 255, 0.2); border-bottom-color: rgba(255, 255, 255, 0.2); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; background-color: rgba(255, 255, 255, 0.01); margin-top: 10px;">
                    <ui:VisualElement name="hatImage" style="flex-grow: 0; background-image: resource(&apos;Faces/Decor5&apos;); width: 80px; height: 80px; background-size: 200% 200%; -unity-background-scale-mode: scale-and-crop;" />
                    <ui:Button text="&#10;" name="DecorButton" class="button-transition" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-left-color: rgba(255, 255, 255, 0.39); border-right-color: rgba(255, 255, 255, 0.39); border-top-color: rgba(255, 255, 255, 0.39); border-bottom-color: rgba(255, 255, 255, 0.39); background-color: rgba(255, 255, 255, 0.02); width: 65px; height: 25px; flex-direction: row; align-items: center; justify-content: center; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                        <ui:VisualElement name="coinImage" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/GameAssets/Galactic%20Orbit%20Assets/CoinImage.png?fileID=2800000&amp;guid=95d2f085caeba477598c6c7014f83f27&amp;type=3#CoinImage&quot;); width: 22px; height: 22px; -unity-background-scale-mode: scale-and-crop; position: relative;" />
                        <ui:Label text="20&#10;" name="price1" style="font-size: 13px; color: rgb(127, 190, 235); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Eagle_Lake/Poppins/Poppins-Medium.ttf?fileID=12800000&amp;guid=f00b46b77f4f241b286026f513a3f4e3&amp;type=3#Poppins-Medium&quot;); -unity-text-align: middle-center;" />
                    </ui:Button>
