<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/GameAssets/StyleSheets/settings.uss?fileID=7433441132597879392&amp;guid=e88e86fe8defdeb4cb2a9fd996ee9526&amp;type=3#settings" />
    <GradientQuad top-color="#000A4EFF" bottom-color="#612CA2FF" style="width: 100%; height: 100%;">
        <GradientQuad bottom-color="#5632B400" top-color="#23086AFF" style="height: 60%; position: absolute; width: 100%; opacity: 0;" />
        <ui:VisualElement name="TopContainer" style="flex-grow: 0; height: 12%;">
            <ui:Label text="Settings" name="settingsLabel" style="top: auto; position: relative; left: auto; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Eagle_Lake/Poppins/Poppins-Bold.ttf?fileID=12800000&amp;guid=b3a755851803b4f499586e81bf43acb6&amp;type=3#Poppins-Bold&quot;); font-size: 20px; color: rgb(255, 255, 255); background-color: rgba(247, 244, 225, 0); padding-left: 8px; padding-right: 8px; width: 100px; height: 30px; -unity-text-align: middle-center; -unity-font-style: normal; align-self: center; margin-top: 20px; border-bottom-width: 1px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255);" />
        </ui:VisualElement>
        <ui:VisualElement name="VisualElement" style="flex-grow: 0; height: 80%;">
            <ui:Label text="Volume" style="color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Eagle_Lake/EagleLake-Regular.ttf?fileID=12800000&amp;guid=291cdbee5253a654a956abc6e4c6e100&amp;type=3#EagleLake-Regular&quot;); margin-left: 16px; margin-right: 16px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-bottom-width: 0.5px; -unity-font-style: bold;" />
            <ui:VisualElement name="Sliders" style="flex-grow: 0; flex-direction: row; justify-content: center;">
                <ui:VisualElement name="MusicSliderContainer" style="flex-grow: 0; width: 80px; height: auto; align-items: center;">
                    <ui:VisualElement name="VisualElement" style="flex-grow: 0; width: 60px; height: 120px; margin-bottom: 10px; flex-shrink: 0;">
                        <ui:Slider value="42" high-value="100" name="musicSlider" style="width: 120px; opacity: 1; visibility: visible; rotate: 90deg; height: 60px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; top: 40px; left: -30px;" />
                    </ui:VisualElement>
                    <ui:Label text="Music" name="musicLabel" style="border-left-color: rgb(114, 109, 168); border-right-color: rgb(114, 109, 168); border-top-color: rgb(114, 109, 168); border-bottom-color: rgb(114, 109, 168); color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins/Poppins-Regular.ttf?fileID=12800000&amp;guid=0bc7df2fde394c74a96504b49e16c221&amp;type=3#Poppins-Regular&quot;); margin-top: 10px; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; align-self: center; -unity-font-style: normal;" />
                </ui:VisualElement>
                <ui:VisualElement name="SFXSliderContainer" style="flex-grow: 0; width: 80px; align-items: center;">
                    <ui:VisualElement name="VisualElement" style="flex-grow: 0; width: 60px; height: 120px; margin-bottom: 10px; flex-shrink: 0;">
                        <ui:Slider value="42" high-value="100" name="SFXSlider" style="width: 120px; height: 60px; rotate: 90deg; opacity: 1; top: 40px; left: -30px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                    </ui:VisualElement>
                    <ui:Label text="SFX" name="SFXLabel" style="border-left-color: rgb(114, 109, 168); border-right-color: rgb(114, 109, 168); border-top-color: rgb(114, 109, 168); border-bottom-color: rgb(114, 109, 168); color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins/Poppins-Regular.ttf?fileID=12800000&amp;guid=0bc7df2fde394c74a96504b49e16c221&amp;type=3#Poppins-Regular&quot;); margin-top: 10px; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; align-self: center;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="Notifications&#10;" name="Label" style="color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Eagle_Lake/EagleLake-Regular.ttf?fileID=12800000&amp;guid=291cdbee5253a654a956abc6e4c6e100&amp;type=3#EagleLake-Regular&quot;); margin-left: 16px; margin-right: 16px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-bottom-width: 0.5px; -unity-font-style: bold; margin-top: 12px;" />
            <ui:VisualElement name="ToggleContainer" style="flex-grow: 0; height: 40%; flex-direction: row;">
                <ui:VisualElement style="flex-grow: 0; justify-content: center; align-items: center; width: 50%;">
                    <ui:Toggle name="eventToggle" enabled="true" style="width: 50px; height: 32px; font-size: 10px; color: rgb(255, 255, 255); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                    <ui:Label text="Event&#10;Notifications" name="eventLabel" style="font-size: 10px; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins/Poppins-Regular.ttf?fileID=12800000&amp;guid=0bc7df2fde394c74a96504b49e16c221&amp;type=3#Poppins-Regular&quot;); -unity-text-align: upper-center;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 0; justify-content: center; align-items: center; width: 50%;">
                    <ui:Toggle name="questToggle" style="width: 50px; height: 30px; font-size: 10px; color: rgb(255, 255, 255);" />
                    <ui:Label text="Quest&#10;Notifications" name="questLabel" style="font-size: 10px; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins/Poppins-Regular.ttf?fileID=12800000&amp;guid=0bc7df2fde394c74a96504b49e16c221&amp;type=3#Poppins-Regular&quot;); -unity-text-align: upper-center;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="&#10;" name="closeButton" class="button-transition" style="flex-direction: row; align-items: center; background-color: rgba(114, 109, 168, 0); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; justify-content: flex-start; -unity-text-align: middle-center; left: auto; border-left-color: rgb(248, 244, 225); border-right-color: rgb(248, 244, 225); border-top-color: rgb(248, 244, 225); border-bottom-color: rgb(248, 244, 225); width: 25px; position: absolute; top: auto; height: 25px; font-size: 10px; background-image: url(&quot;project://database/Assets/GameAssets/Galactic%20Orbit%20Assets/ExitButtonImage.png?fileID=2800000&amp;guid=f2c79e4ceb650a04c9a234aba358efac&amp;type=3#ExitButtonImage&quot;); -unity-background-scale-mode: scale-to-fit; bottom: 20px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; align-self: center;" />
        <ui:Button name="logoutButton" class="button-transition" style="background-color: rgba(255, 0, 0, 0); position: absolute; width: 10px; height: 5px; background-image: url(&quot;project://database/Assets/GameAssets/Galactic%20Orbit%20Assets/redlogoutbackground-removebg-preview.png?fileID=2800000&amp;guid=f7775903ed51b481eae82a6998fe46f8&amp;type=3#redlogoutbackground-removebg-preview&quot;); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); right: 10px; bottom: 20px; -unity-background-scale-mode: scale-to-fit;" />
    </GradientQuad>
</ui:UXML>
