                    <ui:Label text="120/324" style="position: absolute; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Eagle_Lake/EagleLake-Regular.ttf?fileID=12800000&amp;guid=291cdbee5253a654a956abc6e4c6e100&amp;type=3#EagleLake-Regular&quot;); right: 0; color: rgb(56, 23, 137); font-size: 10px; bottom: -6px; -unity-font-style: bold;" />
                </ui:ProgressBar>
