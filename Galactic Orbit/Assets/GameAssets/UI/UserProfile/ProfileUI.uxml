                <ui:Label text="3&#10;" style="margin-top: 0; padding-top: 0; padding-left: 0; padding-bottom: 0; padding-right: 0; margin-right: 0; margin-left: 0; margin-bottom: 0; font-size: 8px; -unity-text-align: middle-left; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Eagle_Lake/EagleLake-Regular.ttf?fileID=12800000&amp;guid=291cdbee5253a654a956abc6e4c6e100&amp;type=3#EagleLake-Regular&quot;);" />
