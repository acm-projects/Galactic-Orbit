<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/GameAssets/StyleSheets/MainMenuStyles.uss?fileID=7433441132597879392&amp;guid=4eb99f4bc115ea1419df7bc60c901dbc&amp;type=3#MainMenuStyles" />
    <ui:VisualElement name="Top" style="flex-grow: 0; flex-shrink: 0; margin-top: 40px; bottom: auto; top: auto; margin-right: 5px;">
        <ui:Button style="background-size: 100% 100%; width: 25px; height: 25px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; right: 0; position: absolute; left: auto; text-overflow: ellipsis; background-image: url(&quot;project://database/Assets/GameAssets/Galactic%20Orbit%20Assets/setting.png?fileID=2800000&amp;guid=e2917992d177ddc4c9354ed8f2a1ce6c&amp;type=3#setting&quot;); background-color: rgba(55, 55, 55, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
    </ui:VisualElement>
    <ui:VisualElement name="Bottom" style="flex-grow: 0; flex-shrink: 0; bottom: 0; position: absolute; margin-left: 0; padding-bottom: 5px; flex-direction: row; justify-content: space-between; flex-wrap: wrap; width: 100%; margin-right: 0; padding-left: 5px; padding-right: 5px;">
        <ui:VisualElement style="flex-grow: 0; width: 70px;">
            <ui:Button text="Profile" style="margin-bottom: 0; margin-right: 0; margin-top: 0; margin-left: 0; padding-top: 0; padding-left: 0; padding-bottom: 0; padding-right: 0; width: 50px; height: 50px; border-top-color: rgb(73, 27, 84); border-left-color: rgb(73, 28, 85); border-bottom-color: rgb(73, 28, 85); border-right-color: rgb(73, 28, 85); border-top-left-radius: 25px; border-top-right-radius: 25px; border-bottom-right-radius: 25px; border-bottom-left-radius: 25px; background-color: rgb(177, 126, 189);" />
            <ui:VisualElement style="flex-grow: 1; margin-top: 5px;">
                <ui:ProgressBar value="60" class="my-progressbar" style="margin-top: 0; margin-bottom: 0; margin-left: 0; margin-right: 0; height: 10px;" />
                <ui:Label text="15&#10;" style="position: absolute; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; color: rgb(255, 255, 255); -unity-font-style: normal; font-size: 10px; top: -8px; left: -2px; background-color: rgb(30, 39, 123); border-bottom-left-radius: 10px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(0, 0, 0); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0); position: absolute; flex-direction: row; justify-content: center;">
            <ui:Button style="background-image: url(&quot;project://database/Assets/GameAssets/Galactic%20Orbit%20Assets/galaxy.png?fileID=2800000&amp;guid=5fc33bc41ed652740b367c520398de04&amp;type=3#galaxy&quot;); background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; width: 50px; padding-left: 0; padding-right: 0; padding-bottom: 0; padding-top: 0; margin-top: 0; margin-left: 0; margin-bottom: 0; margin-right: 0; height: 50px; bottom: auto; position: absolute;" />
