            <ui:Button style="background-image: url(&quot;project://database/Assets/GameAssets/Galactic%20Orbit%20Assets/journal.png?fileID=2800000&amp;guid=58ebccba2f16f8b42910e4c9b51b8035&amp;type=3#journal&quot;); background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; width: 75%; padding-left: 0; padding-right: 0; padding-bottom: 0; padding-top: 0; margin-top: 0; margin-left: 0; margin-bottom: 0; margin-right: 0; height: 75%; bottom: auto; position: relative;" />
