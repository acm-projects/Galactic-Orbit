                    <ui:Button name="shopButton" class="button-transition" style="background-image: url(&quot;project://database/Assets/GameAssets/Galactic%20Orbit%20Assets/dollar-button.png?fileID=2800000&amp;guid=31644c350be204585a731b3091928e0f&amp;type=3#dollar-button&quot;); background-color: rgba(0, 0, 0, 0); width: 80px; height: 80px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
                </ui:VisualElement>
                <ui:VisualElement name="Gap" style="flex-grow: 0; width: 30px;" />
                <ui:VisualElement style="flex-grow: 0;">
                    <ui:VisualElement name="BigStar1" style="flex-grow: 1; position: absolute; background-image: url(&quot;project://database/Assets/GameAssets/Galactic%20Orbit%20Assets/BigStar.png?fileID=2800000&amp;guid=c06034618e7d64f87bd27d964d4db017&amp;type=3#BigStar&quot;); width: 170px; height: 170px; left: -40px; top: -35px; opacity: 0.2;" />
                    <ui:Button name="customizeButton" selectable="true" class="button-transition" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: url(&quot;project://database/Assets/GameAssets/Galactic%20Orbit%20Assets/customize.png?fileID=2800000&amp;guid=ad78dda4df226e649b6beede7b727dd4&amp;type=3#customize&quot;); width: 80px; height: 80px; background-color: rgba(0, 0, 0, 0); padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                </ui:VisualElement>
            </ui:VisualElement>
