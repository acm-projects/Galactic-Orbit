                <ui:VisualElement name="BigStar1" style="flex-grow: 1; position: absolute; background-image: url(&quot;project://database/Assets/GameAssets/Galactic%20Orbit%20Assets/BigStar.png?fileID=2800000&amp;guid=c06034618e7d64f87bd27d964d4db017&amp;type=3#BigStar&quot;); width: 170px; height: 170px; left: -40px; top: -35px; opacity: 0.2;" />
                <ui:Button name="cameraButton" class="button-transition" style="background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: url(&quot;project://database/Assets/GameAssets/Galactic%20Orbit%20Assets/camera-button.png?fileID=2800000&amp;guid=f7d1cb6f9e2a94648b98152724eec2ed&amp;type=3#camera-button&quot;); width: 80px; height: 80px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
