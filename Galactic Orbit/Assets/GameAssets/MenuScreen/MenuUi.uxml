<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/GameAssets/StyleSheets/MenuStyles.uss?fileID=7433441132597879392&amp;guid=aadd0eac585be9d4f8f92d05f7977539&amp;type=3" />
    <ui:VisualElement name="ColorBackground" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/GameAssets/Quest/QuestDetailBG.png?fileID=2800000&amp;guid=a04ada263b616ac40a4f0c4bd289be87&amp;type=3#QuestDetailBG&quot;); position: relative; top: 0; right: 0; bottom: 0; left: 0;">
        <ui:VisualElement name="BottomSection" style="flex-grow: 1; position: absolute; bottom: 0; width: 100%; height: 50%; margin-bottom: 50px; align-items: center;">
            <ui:VisualElement name="RowSection" style="flex-grow: 1; flex-direction: row; justify-content: center; width: 100%;">
                <ui:VisualElement style="flex-grow: 0;">
